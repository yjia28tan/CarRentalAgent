# Copy to secrets.env and fill in. secrets.env is git-ignored and never baked into images.
# Any key in src/config/config.yaml can also be overridden here (e.g. LOG_LEVEL=DEBUG).

APP_ENV=dev

JWT_SECRET=change-me

# Hostnames below are the docker-compose service names. When running a service directly on
# your machine, point them at localhost instead.
POSTGRES_PASSWORD=rental_dev
POSTGRES_DSN=postgresql://rental:rental_dev@postgres:5432/rental
MONGO_URI=mongodb://mongo:27017
REDIS_URL=redis://redis:6379/0
MOCK_SERVICES_URL=http://mock_services:8001
AGENT_API_URL=http://app:8000

# Azure OpenAI (LLM_MODEL = deployment name)
LLM_PROVIDER=azure_openai
LLM_MODEL=
LLM_API_KEY=
LLM_ENDPOINT=
LLM_API_VERSION=
